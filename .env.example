# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=
# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# 테스트 서버 ID (지정하면 커맨드가 즉시 반영됨. 비우면 글로벌 등록 — 반영까지 최대 1시간)
DISCORD_GUILD_ID=

# GitHub fine-grained PAT (Public repositories read-only 면 충분). 없으면 시간당 60회 한도라 크롤링 불가
GITHUB_TOKEN=

# (선택) 한국어 요약 — Claude API
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# (선택) skills.sh v1 API 용 Vercel OIDC 토큰. 없어도 공개 검색으로 설치 수를 가져옴
SKILLS_SH_TOKEN=
SKILLS_SH_QUERIES_PER_REPO=8

# 주간 다이제스트 (Asia/Seoul) — 0=일 1=월 ... 6=토
DIGEST_DAY=1
DIGEST_HOUR=10

# --- 선택 설정 ---
REFRESH_HOURS=6
MAX_REPOS=300
MIN_STARS=20
MAX_SKILLS_PER_REPO=40
MAX_CURATED_FETCH=200
