# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=
# Discord Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=
# 테스트 서버 ID (지정하면 커맨드가 즉시 반영됨. 비우면 글로벌 등록 — 반영까지 최대 1시간)
DISCORD_GUILD_ID=

# GitHub fine-grained PAT (Public repositories read-only 면 충분). 없으면 시간당 60회 한도라 크롤링 불가
GITHUB_TOKEN=

# --- 선택 설정 ---
REFRESH_HOURS=6
MAX_REPOS=300
MIN_STARS=20
MAX_SKILLS_PER_REPO=40
MAX_CURATED_FETCH=200
